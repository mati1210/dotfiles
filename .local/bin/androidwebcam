#!/bin/zsh
: ${VID:=1}
: ${MICPREFIX:=androidmic}
: ${ANDROIDSSHHOST:=phone}
: ${ANDROIDPORT:=8545}

# setup microphone
MONO=1 TYPE=speaker pw-virtual-node $MICPREFIX-in
MONO=1 TYPE=mic pw-virtual-node $MICPREFIX-out
pw-link androidmic-in androidmic-out
outargs=( -avioflags direct )

if (( VID )) {
	module=v4l2loopback
	(lsmod|grep -q $module) || sudo modprobe $module

	sdp_prefix=h264_
	vidargs=( $outargs -map v -f v4l2 /dev/video0 )
} else {
	sdp_prefix=''
	vidargs=( )
}

ANDROIDIP="$(ssh -G $ANDROIDSSHHOST| awk '$1 == "hostname" { print $2 }')"

# check if ip webcam already running
if ! ncat -vw1 $ANDROIDIP $ANDROIDPORT </dev/null; then
	# this only works if you patch the app to set the Rolling activity exportable
	ssh $ANDROIDSSHHOST am start -n com.pas.webcam/.Rolling
	sleep 1 # wait for app to open up
fi

ffmpeg \
	-fflags nobuffer -flags low_delay \
	-i rtsp://$ANDROIDIP:$ANDROIDPORT/${sdp_prefix}opus.sdp \
	$outargs -map a -f pulse -device $MICPREFIX-in androidwebcam \
	$vidargs
