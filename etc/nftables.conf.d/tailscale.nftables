#!/bin/nft -f
define tailscale_range = 100.64.0.0/10
define tailscalev6_range = fd7a:115c:a1e0::/48
add element inet main LANv4 { $tailscale_range }

add rule inet main forward iifname "tailscale0" accept
table inet main {
  chain postrouting {
    type nat hook postrouting priority filter

    ip  saddr $tailscale_range    ip  daddr != $tailscale_range   masquerade
    ip6 saddr $tailscalev6_range ip6 daddr != $tailscalev6_range masquerade
  }
}
