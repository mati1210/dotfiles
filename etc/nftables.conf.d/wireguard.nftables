#!/bin/nft -f
add element inet main allowed_udp { 51820 }
add rule inet main forward iifname "wg0" accept

table inet main {
  chain postrouting {
    type nat hook postrouting priority filter

    # All WireGuard traffic will look like it comes from the servers IP address.
    ip saddr 10.12.10.0/24 ip daddr != 10.12.10.0/24 masquerade
    ip6 saddr fd12:10::/64 ip6 daddr != fd12:10::/64 masquerade
  }
}
