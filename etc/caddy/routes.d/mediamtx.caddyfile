route /live/* {
	uri strip_prefix /live

	@live `!path('*/whep*') && !method('GET', 'HOST', 'OPTIONS')`
	respond @live "writer no writing!" 405

	@hls `query({"hls": "yes"}) || header({"hls": "yes"}) || path('*hls*')`
	vars proxyPort 8889
	header @hls yes
	vars @hls proxyPort 8888

	import auth
	reverse_proxy {
		to localhost:{vars.proxyPort}
		header_down Location ^/ /live/
	}
}
