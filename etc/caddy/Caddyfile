# https://caddyserver.com/docs/
{
	admin "unix//run/caddy/admin.socket"
	email {$ACMEMAIL}
	persist_config off

	acme_dns cloudflare {env.CLOUDFLARE_TOKEN}
	dns cloudflare {env.CLOUDFLARE_TOKEN}
	ech {$ECH}

	import l4/Caddyfile
}

import /etc/caddy/snippets.d/* 
{$HOSTS} {
	log
	encode

	handle_errors {
		respond "{err.status_code} {err.status_text}: {err.message}"
	}

	header Strict-Transport-Security "max-age=31550000"
	header X-Robots-Tag "noindex, nofollow"
	import routes.d/*.caddyfile

	error "idk man" 400
}
